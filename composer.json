{
    "name": "ahmed-asban/laravel-migration-atlas",
    "description": "Database-free static analysis of Laravel migrations for expected schemas, history, and column lineage.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "migrations", "schema", "static-analysis"],
    "homepage": "https://github.com/ahmed-asban/laravel-migration-atlas",
    "authors": [
        {
            "name": "Ahmed Asban"
        }
    ],
    "support": {
        "issues": "https://github.com/ahmed-asban/laravel-migration-atlas/issues",
        "source": "https://github.com/ahmed-asban/laravel-migration-atlas"
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8.7",
        "pestphp/pest-plugin-arch": "^3.1.1",
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "MigrationAtlas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MigrationAtlas\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MigrationAtlas\\MigrationAtlasServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "lint": "@php vendor/bin/pint --test",
        "format": "@php vendor/bin/pint",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=512M",
        "check": [
            "@composer validate --strict",
            "@test",
            "@lint",
            "@analyse"
        ]
    }
}
